{% extends 'base.html.twig' %}

{% block title %}Liste des Produits{% endblock %}

{% block body %}
    <h1>Liste de nos produits</h1>

    <table border="1" cellpadding="10" style="border-collapse: collapse; width: 100%; margin-top: 20px;">
        <thead>
            <tr style="background-color: #f2f2f2;">
                <th>Référence</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.reference }}</td>
                    <td>{{ product.nom }}</td>
                    <td>{{ product.description }}</td>
                    <td>{{ product.prix }} €</td>
                    <td>{{ product.stock }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun produit trouvé dans la base de données.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}